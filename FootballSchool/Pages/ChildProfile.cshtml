@page
@model FootballSchool.Pages.ChildProfileModel
@{
    ViewData["Title"] = "Профили детей";
}

<div class="container py-4">
    <h1 class="mb-4">Управление профилями детей</h1>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-success" role="alert">@Model.StatusMessage</div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Поиск</h5>
            <form method="get" class="row g-2">
                <div class="col-md-10">
                    <input type="text" class="form-control" name="search" value="@Model.Search" placeholder="ФИО ребенка, телефон или ФИО родителя" />
                </div>
                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-primary">Найти</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Добавить профиль ребенка</h5>
            <form method="post" asp-page-handler="Create" class="row g-3">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="col-md-4">
                    <label asp-for="CreateChild.SurnameStudent" class="form-label"></label>
                    <input asp-for="CreateChild.SurnameStudent" class="form-control" />
                    <span asp-validation-for="CreateChild.SurnameStudent" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="CreateChild.NameStudent" class="form-label"></label>
                    <input asp-for="CreateChild.NameStudent" class="form-control" />
                    <span asp-validation-for="CreateChild.NameStudent" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="CreateChild.BirthStudent" class="form-label"></label>
                    <input asp-for="CreateChild.BirthStudent" type="date" class="form-control" />
                    <span asp-validation-for="CreateChild.BirthStudent" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="CreateChild.GenderStudent" class="form-label"></label>
                    <select asp-for="CreateChild.GenderStudent" class="form-select">
                        <option value="">Выберите пол</option>
                        <option value="Мужской">Мужской</option>
                        <option value="Женский">Женский</option>
                    </select>
                    <span asp-validation-for="CreateChild.GenderStudent" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="CreateChild.ParentNumber" class="form-label"></label>
                    <input asp-for="CreateChild.ParentNumber" class="form-control" />
                    <span asp-validation-for="CreateChild.ParentNumber" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="CreateChild.LevelStudent" class="form-label"></label>
                    <input asp-for="CreateChild.LevelStudent" class="form-control" />
                    <span asp-validation-for="CreateChild.LevelStudent" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="CreateChild.PhoneStudent" class="form-label"></label>
                    <input asp-for="CreateChild.PhoneStudent" class="form-control" />
                    <span asp-validation-for="CreateChild.PhoneStudent" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="CreateChild.SurnameParent" class="form-label"></label>
                    <input asp-for="CreateChild.SurnameParent" class="form-control" />
                    <span asp-validation-for="CreateChild.SurnameParent" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="CreateChild.NameParent" class="form-label"></label>
                    <input asp-for="CreateChild.NameParent" class="form-control" />
                    <span asp-validation-for="CreateChild.NameParent" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="CreateChild.CityStudent" class="form-label"></label>
                    <input asp-for="CreateChild.CityStudent" class="form-control" />
                    <span asp-validation-for="CreateChild.CityStudent" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CreateChild.StreetStudent" class="form-label"></label>
                    <input asp-for="CreateChild.StreetStudent" class="form-control" />
                    <span asp-validation-for="CreateChild.StreetStudent" class="text-danger"></span>
                </div>
                <div class="col-md-2">
                    <label asp-for="CreateChild.HouseStudent" class="form-label"></label>
                    <input asp-for="CreateChild.HouseStudent" class="form-control" />
                    <span asp-validation-for="CreateChild.HouseStudent" class="text-danger"></span>
                </div>
                <div class="col-md-2">
                    <label asp-for="CreateChild.ApartmentStudent" class="form-label"></label>
                    <input asp-for="CreateChild.ApartmentStudent" class="form-control" />
                </div>
                <div class="col-md-2 d-grid align-content-end">
                    <button type="submit" class="btn btn-success">Создать</button>
                </div>
            </form>
        </div>
    </div>

    @if (Model.EditChild is not null)
    {
        <div class="card mb-4 border-warning">
            <div class="card-body">
                <h5 class="card-title">Редактирование профиля #@Model.EditChild.StudentId</h5>
                <form method="post" asp-page-handler="Edit" class="row g-3">
                    <input type="hidden" asp-for="EditChild.StudentId" />
                    <div class="col-md-4">
                        <label asp-for="EditChild.SurnameStudent" class="form-label"></label>
                        <input asp-for="EditChild.SurnameStudent" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="EditChild.NameStudent" class="form-label"></label>
                        <input asp-for="EditChild.NameStudent" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="EditChild.BirthStudent" class="form-label"></label>
                        <input asp-for="EditChild.BirthStudent" type="date" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="EditChild.GenderStudent" class="form-label"></label>
                        <select asp-for="EditChild.GenderStudent" class="form-select">
                            <option value="Мужской">Мужской</option>
                            <option value="Женский">Женский</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="EditChild.ParentNumber" class="form-label"></label>
                        <input asp-for="EditChild.ParentNumber" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="EditChild.LevelStudent" class="form-label"></label>
                        <input asp-for="EditChild.LevelStudent" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="EditChild.PhoneStudent" class="form-label"></label>
                        <input asp-for="EditChild.PhoneStudent" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="EditChild.SurnameParent" class="form-label"></label>
                        <input asp-for="EditChild.SurnameParent" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="EditChild.NameParent" class="form-label"></label>
                        <input asp-for="EditChild.NameParent" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="EditChild.CityStudent" class="form-label"></label>
                        <input asp-for="EditChild.CityStudent" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EditChild.StreetStudent" class="form-label"></label>
                        <input asp-for="EditChild.StreetStudent" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label asp-for="EditChild.HouseStudent" class="form-label"></label>
                        <input asp-for="EditChild.HouseStudent" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label asp-for="EditChild.ApartmentStudent" class="form-label"></label>
                        <input asp-for="EditChild.ApartmentStudent" class="form-control" />
                    </div>
                    <div class="col-md-2 d-grid align-content-end">
                        <button type="submit" class="btn btn-warning">Сохранить</button>
                    </div>
                </form>
            </div>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Список профилей</h5>
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Ребенок</th>
                            <th>Дата рождения</th>
                            <th>Пол</th>
                            <th>Уровень</th>
                            <th>Родитель</th>
                            <th>Телефон</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Children.Any())
                        {
                            @foreach (var child in Model.Children)
                            {
                                <tr>
                                    <td>@child.StudentId</td>
                                    <td>@child.SurnameStudent @child.NameStudent</td>
                                    <td>@child.BirthStudent.ToString("dd.MM.yyyy")</td>
                                    <td>@child.GenderStudent</td>
                                    <td>@child.LevelStudent</td>
                                    <td>@child.SurnameParent @child.NameParent</td>
                                    <td>@(string.IsNullOrWhiteSpace(child.PhoneStudent) ? child.ParentNumber : child.PhoneStudent)</td>
                                    <td class="d-flex gap-2">
                                        <a asp-page="/ChildProfile" asp-route-search="@Model.Search" asp-route-editId="@child.StudentId" class="btn btn-sm btn-outline-primary">Изменить</a>
                                        <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Удалить профиль ребенка?');">
                                            <input type="hidden" name="id" value="@child.StudentId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted">Профили не найдены.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
